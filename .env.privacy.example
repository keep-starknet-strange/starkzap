# Manual privacy-pool testing (scripts/privacy-manual-test.ts).
# Copy to .env.privacy.local — that file is gitignored, this one is not.
#
# The prover and discovery services currently used for development are
# internal StarkWare infrastructure and are NOT for public consumption.
# Never commit their URLs; fill them in locally only.

PRIVACY_NETWORK=mainnet
PRIVACY_RPC_URL=

# Privacy pool contract. Used verbatim to derive the viewing key, so it must
# byte-match the form other wallets use for the same pool.
PRIVACY_POOL_ADDRESS=

# Proving and discovery service endpoints.
PRIVACY_PROVER_URL=
PRIVACY_DISCOVERY_URL=

# ERC20 to shield. Use a throwaway account with a small balance.
PRIVACY_TOKEN_ADDRESS=
PRIVACY_PRIVATE_KEY=
