{
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    // expo/tsconfig.base sets noEmit:true; the build must emit dist/, so override it.
    "noEmit": false,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "starkzap": ["../../dist/src/index.d.ts"],
      "starkzap/*": ["../../dist/src/*"]
    },
    "module": "esnext",
    "moduleResolution": "bundler",
    "target": "es2020",
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true
  },
  "tsc-alias": {
    "resolveFullPaths": true,
    "resolveFullExtension": ".js"
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"],
  "extends": "expo/tsconfig.base"
}
