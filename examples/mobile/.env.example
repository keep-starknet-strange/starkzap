# required
EXPO_PUBLIC_PRIVY_APP_ID=
EXPO_PUBLIC_PRIVY_SERVER_URL=

# optional:
# Privy client id for Expo provider.
# EXPO_PUBLIC_PRIVY_CLIENT_ID=
# If omitted, defaults to `${EXPO_PUBLIC_PRIVY_SERVER_URL}/api/paymaster`.
# EXPO_PUBLIC_PAYMASTER_PROXY_URL=

# Cartridge native session (optional). Required preset enables the Cartridge login button.
# EXPO_PUBLIC_CARTRIDGE_PRESET=
# Defaults to https://x.cartridge.gg when unset.
# EXPO_PUBLIC_CARTRIDGE_URL=
# OAuth return URL; defaults via Expo Linking (see README). Must match Cartridge allowlist if set.
# EXPO_PUBLIC_CARTRIDGE_REDIRECT_URL=
