# Local wallet — private key login used when developing
EXPO_PRIVATE_KEY=
# Account preset for that key (e.g. openzeppelin, argent, braavos)
EXPO_ACCOUNT_PRESET=
# Network the app starts on: mainnet | sepolia
EXPO_NETWORK=sepolia

# WalletConnect / Reown project id
EXPO_PUBLIC_REOWN_PROJECT_ID=

# Privy login
EXPO_PUBLIC_PRIVY_APP_ID=
EXPO_PUBLIC_PRIVY_CLIENT_ID=
# Backend that mints Privy auth tokens (examples/server)
EXPO_PUBLIC_PRIVY_SERVER_URL=

# Layerswap bridging keys, per network
EXPO_PUBLIC_LAYERSWAP_API_KEY_MAINNET=
EXPO_PUBLIC_LAYERSWAP_API_KEY_TESTNET=

# Hyperlane OFT public key
EXPO_PUBLIC_OFT_PUBLIC_KEY=

# Alchemy RPC key
EXPO_PUBLIC_ALCHEMY_API_KEY=

# Proxy that holds the AVNU paymaster API key (examples/server exposes one at
# /api/paymaster). Required for privacy: transactions are submitted by the
# paymaster's relayer, which is what keeps your account off-chain.
EXPO_PUBLIC_PAYMASTER_PROXY_URL=

# STRK20 privacy pool contract, per network
EXPO_PUBLIC_PRIVACY_POOL_MAINNET=
EXPO_PUBLIC_PRIVACY_POOL_SEPOLIA=
# Transaction prover that builds proofs and runs screening
EXPO_PUBLIC_PRIVACY_PROVER_MAINNET=
EXPO_PUBLIC_PRIVACY_PROVER_SEPOLIA=
# Indexer that discovers your notes and channels
EXPO_PUBLIC_PRIVACY_DISCOVERY_MAINNET=
EXPO_PUBLIC_PRIVACY_DISCOVERY_SEPOLIA=
# Oblivious HTTP relay that hides your IP from prover and indexer
EXPO_PUBLIC_PRIVACY_OHTTP_RELAY=
# Set to "false" to talk to prover and indexer directly, without OHTTP
EXPO_PUBLIC_PRIVACY_OHTTP=

# Pool fee mode: sponsored (default) | sponsored_private | default. Privacy
# transactions are relayer-submitted either way — the choice is cost. sponsored
# needs the paymaster API key (reuses EXPO_PUBLIC_PAYMASTER_PROXY_URL); default
# needs none but the forwarder keeps the whole suggested-max gas withdrawal.
EXPO_PUBLIC_PRIVACY_FEE_MODE=
# Fee token — required by sponsored_private and default, ignored by sponsored.
EXPO_PUBLIC_PRIVACY_FEE_TOKEN=
