# Privy Configuration
# Get these from https://dashboard.privy.io/

# Client-side: Exposed to browser, used by PrivyProvider
NEXT_PUBLIC_PRIVY_APP_ID=your_privy_app_id

# Server-side only: Used by API routes (sign, starknet)
# Do NOT prefix with NEXT_PUBLIC_ to keep it secret
PRIVY_APP_ID=your_privy_app_id
PRIVY_APP_SECRET=your_privy_app_secret

# Starknet RPC URL
NEXT_PUBLIC_RPC_URL=https://api.cartridge.gg/x/starknet/sepolia/rpc/v0_9

# AVNU Paymaster (optional, for sponsored transactions)
AVNU_API_KEY=your_avnu_api_key
AVNU_PAYMASTER_URL=https://sepolia.paymaster.avnu.fi
