# Copy to .env (gitignored) and fill in what you need. Everything is optional
# unless noted; features whose keys are missing are hidden or fall back.

# ─── Network & RPC ───────────────────────────────────────────────────────────

# Default network: "mainnet" or "sepolia" (default sepolia). Switchable at
# runtime via the UI or ?network=.
VITE_NETWORK=sepolia

# Starknet RPC. Used for both networks; the per-network keys take precedence.
VITE_RPC_URL=
VITE_MAINNET_RPC_URL=
VITE_SEPOLIA_RPC_URL=

# Alchemy key. Builds the default Starknet + Ethereum RPC URLs when the
# explicit ones above are unset.
VITE_ALCHEMY_API_KEY=

# ─── Auto sign-in ────────────────────────────────────────────────────────────

# When set, the app signs in on load with this key instead of showing Connect.
VITE_PRIVATE_KEY=

# Account class for the auto sign-in: openzeppelin | argent | argentx050 |
# braavos | devnet (default openzeppelin).
VITE_ACCOUNT_PRESET=openzeppelin

# ─── Privy login ─────────────────────────────────────────────────────────────

# Privy app credentials. Both required for the in-browser Privy (email OTP) flow.
VITE_PRIVY_APP_ID=
VITE_PRIVY_CLIENT_ID=

# Example server that signs for Privy wallets (default http://localhost:3001).
VITE_PRIVY_SERVER_URL=

# ─── Paymaster ───────────────────────────────────────────────────────────────

# Proxy that holds the AVNU paymaster API key. Unset disables the sponsored
# toggles. Point at the example server: http://localhost:3001/api/paymaster
VITE_PAYMASTER_PROXY_URL=

# ─── Bridge ──────────────────────────────────────────────────────────────────

# WalletConnect/Reown project id. Enables connecting an external EVM wallet.
VITE_REOWN_PROJECT_ID=

# Solana RPC, for Solana bridge routes.
VITE_SOLANA_RPC_URL=

# LayerZero API key, required for OFT bridging (mainnet only).
VITE_OFT_PUBLIC_KEY=

# Layerswap API keys, per network. VITE_LAYERSWAP_API_KEY is the fallback.
VITE_LAYERSWAP_API_KEY_MAINNET=
VITE_LAYERSWAP_API_KEY_TESTNET=
VITE_LAYERSWAP_API_KEY=

# Override the Layerswap API base URL.
VITE_LAYERSWAP_BASE_URL=

# ─── STRK20 privacy pool ─────────────────────────────────────────────────────
#
# Per network, because the app switches chains at runtime. Blank keys disable
# the STRK20 tab on that network; the Tongo tab is unaffected.
#
# Privacy pool contract. Used verbatim to derive the viewing key, so it must
# byte-match the form other wallets use for the same pool.
VITE_PRIVACY_POOL_MAINNET=
VITE_PRIVACY_POOL_SEPOLIA=

# Proving service, generates the validity proof for each private transaction.
VITE_PRIVACY_PROVER_MAINNET=
VITE_PRIVACY_PROVER_SEPOLIA=

# Discovery service, indexes encrypted on-chain state so the wallet can find
# its own notes.
VITE_PRIVACY_DISCOVERY_MAINNET=
VITE_PRIVACY_DISCOVERY_SEPOLIA=

# Encrypt requests to those two services so the viewing key is not readable by
# the operator. Defaults to on; set "false" only if the server lacks OHTTP.
VITE_PRIVACY_OHTTP=true

# Optional OHTTP relay, hides the client IP from the discovery service.
VITE_PRIVACY_OHTTP_RELAY=

# Ekubo swap executor. Enables the anonymous swap operation.
VITE_PRIVACY_SWAP_ANONYMIZER_MAINNET=
VITE_PRIVACY_SWAP_ANONYMIZER_SEPOLIA=

# Vesu lending anonymizer. Enables the anonymous lending operation.
VITE_PRIVACY_LENDING_ANONYMIZER_MAINNET=
VITE_PRIVACY_LENDING_ANONYMIZER_SEPOLIA=
