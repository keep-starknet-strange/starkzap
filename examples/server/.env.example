# Each feature is opt-in via its ENABLE_* flag. A flag left off (or unset) means
# that feature's routes are NOT registered and its other vars are NOT required.
# With no flags set, the server serves only /api/health on :3001.

# --- Privy embedded wallets ---
# ENABLE_PRIVY=true requires both credentials below.
ENABLE_PRIVY=true
PRIVY_APP_ID=your_privy_app_id
PRIVY_APP_SECRET=your_privy_app_secret

# --- AVNU Paymaster proxy ---
# ENABLE_PAYMASTER=true registers /api/paymaster.
# AVNU_API_KEY is optional: set it for sponsored (gasfree) mode; without it,
# gasless mode (user pays in tokens) still works.
# AVNU_PAYMASTER_URL is optional (defaults to the Sepolia paymaster).
ENABLE_PAYMASTER=true
AVNU_API_KEY=your_avnu_api_key
AVNU_PAYMASTER_URL=https://sepolia.paymaster.avnu.fi
