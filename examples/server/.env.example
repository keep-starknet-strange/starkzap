# Each feature is opt-in via its ENABLE_* flag. A flag left off (or unset) means
# that feature's routes are NOT registered and its other vars are NOT required.
# With no flags set, the server serves only /api/health on :3001.

# --- Privy embedded wallets ---
# ENABLE_PRIVY=true requires both credentials below.
ENABLE_PRIVY=true
PRIVY_APP_ID=your_privy_app_id
PRIVY_APP_SECRET=your_privy_app_secret

# --- AVNU Paymaster proxy ---
# ENABLE_PAYMASTER=true registers /api/paymaster/mainnet and
# /api/paymaster/sepolia. The network is part of the path because each AVNU
# deployment whitelists only its own privacy pool: forward a mainnet pool to the
# Sepolia paymaster and it answers "privacy pool address is not whitelisted".
# One API key covers both networks.
#
# AVNU_API_KEY is optional: set it for sponsored (gasfree) mode; without it,
# gasless mode (user pays in tokens) still works.
# Both upstream URLs are optional and default to AVNU's public endpoints —
# override them to point at a staging deployment.
ENABLE_PAYMASTER=true
AVNU_API_KEY=your_avnu_api_key
AVNU_PAYMASTER_URL_MAINNET=https://starknet.paymaster.avnu.fi
AVNU_PAYMASTER_URL_SEPOLIA=https://sepolia.paymaster.avnu.fi
